# Local dev only. When deployed with `carto app deploy`, these come from ./carto-info.json
# (the signed-in viewer's own token) and nothing here is used.
# Get a token with: carto auth status / or create an API token. Never commit .env.local.
VITE_CARTO_TOKEN=
VITE_CARTO_API_BASE_URL=https://gcp-us-east1.api.carto.com
# OpenAI-compatible LiteLLM proxy (see: carto aiproxy info)
VITE_CARTO_AI_BASE_URL=https://litellm-gcp-us-east1.api.carto.com/v1
# CARTO connection (BigQuery) with read access to bigquery-public-data
VITE_CARTO_CONNECTION=carto_dw
# Default model id as listed by: carto aiproxy models
VITE_DEFAULT_MODEL=
