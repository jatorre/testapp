        "name": "run_sql",
        "input": {
          "sql": "SELECT\n  SUM(CASE WHEN ST_CONTAINS(ST_GEOGFROMGEOJSON('{\"type\":\"Polygon\",\"coordinates\":[[[-97.6,33.4],[-96,33.3],[-94.7,30.2],[-94.9,29.3],[-95.6,29],[-98.9,29],[-99,29.8],[-97.6,33.4]]]}'), ST_GEOGPOINT(longitude, latitude)) THEN 1 ELSE 0 END) as customers_in_a1,\n  SUM(CASE WHEN NOT ST_CONTAINS(ST_GEOGFROMGEOJSON('{\"type\":\"Polygon\",\"coordinates\":[[[-97.6,33.4],[-96,33.3],[-94.7,30.2],[-94.9,29.3],[-95.6,29],[-98.9,29],[-99,29.8],[-97.6,33.4]]]}'), ST_GEOGPOINT(longitude, latitude)) THEN 1 ELSE 0 END) as customers_in_rest_of_texas\nFROM `bigquery-public-data.thelook_ecommerce.users`\nWHERE state = 'Texas' AND country = 'United States'"
        },
