        "input": {
          "sql": "WITH area AS (\n  SELECT ST_GEOGFROMTEXT('POLYGON((-87.6 31, -86.2 30.9, -85 31, -83.6 30.9, -82.3 30.8, -81.3 30.9, -80.9 30, -80.5 28.9, -80 27.6, -79.8 26.4, -80 25.3, -80.6 24.9, -81.4 25.2, -81.9 26, -82.6 27, -82.9 28.1, -83 29, -83.9 29.8, -85.2 29.5, -86.4 30.2, -87.6 30.2, -87.6 31))') AS geom\n)\nSELECT \n  COUNT(DISTINCT u.id) AS user_count,\n  COUNT(DISTINCT o.order_id) AS order_count,\n  ROUND(SUM(oi.sale_price), 2) AS total_revenue\nFROM bigquery-public-data.thelook_ecommerce.users u\nJOIN area ON ST_INTERSECTS(ST_GEOGPOINT(u.longitude, u.latitude), area.geom)\nLEFT JOIN bigquery-public-data.thelook_ecommerce.orders o ON u.id = o.user_id\nLEFT JOIN bigquery-public-data.thelook_ecommerce.order_items oi ON o.order_id = oi.order_id"
