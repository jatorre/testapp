      {
        "id": "call_3717698__thought__",
        "name": "run_sql",
        "input": {
          "sql": "WITH Actuals AS (\n    SELECT\n        u.country,\n        SUM(oi.sale_price) AS actual_revenue_2023\n    FROM `bigquery-public-data.thelook_ecommerce.order_items` oi\n    JOIN `bigquery-public-data.thelook_ecommerce.users` u ON oi.user_id = u.id\n    WHERE EXTRACT(YEAR FROM oi.created_at) = 2023\n      AND oi.status NOT IN ('Cancelled', 'Returned')\n    GROUP BY u.country\n)\nSELECT\n    t.country,\n    t.target_revenue_2023,\n    COALESCE(a.actual_revenue_2023, 0) AS actual_revenue,\n    (t.target_revenue_2023 - COALESCE(a.actual_revenue_2023, 0)) AS missed_by\nFROM `carto-dw-ac-7xhfwyml.private_jatorre_761bd3f5.agent_tmp_targets_2023` t\nLEFT JOIN Actuals a ON t.country = a.country\nWHERE COALESCE(a.actual_revenue_2023, 0) < t.target_revenue_2023\nORDER BY missed_by DESC"
        },
        "startedAt": 1791453580186,
