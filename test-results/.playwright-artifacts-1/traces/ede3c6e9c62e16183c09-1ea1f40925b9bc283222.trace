{"type":"frame-snapshot","snapshot":{"callId":"call@12","snapshotName":"after@call@12","pageId":"page@b9fc52c12c591ecea44c383569aeadd2","frameId":"frame@903e7e212bc70878379a7489cab6bd82","frameUrl":"http://localhost:5173/?demo=d1-fs&harness=handrolled","doctype":"html","html":["HTML",{"lang":"en"},["HEAD",{},["BASE",{"href":"http://localhost:5173/?demo=d1-fs&harness=handrolled"}],"\n    ","\n\n    ","\n\n    ",["META",{"charset":"utf-8"}],"\n    ",["LINK",{"rel":"icon","type":"image/svg+xml","href":"/favicon.svg"}],"\n    ",["META",{"name":"viewport","content":"width=device-width, initial-scale=1.0"}],"\n    ",["TITLE",{},"Browser Agent Eval"],"\n  ",["STYLE",{},":root {\n  --bg: #f7f7f8;\n  --panel: #ffffff;\n  --text: #1d1d22;\n  --muted: #6b6b76;\n  --border: #e3e3e8;\n  --accent: #2f5bea;\n  --accent-bg: #eef2ff;\n  --ok: #1f9d55;\n  --err: #c62828;\n  --err-bg: #fdecec;\n  --code-bg: #f3f3f6;\n  --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n  --sans: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;\n  font: 14px/1.45 var(--sans);\n  color: var(--text);\n  background: var(--bg);\n}\n@media (prefers-color-scheme: dark) {\n  :root {\n    --bg: #15161a;\n    --panel: #1d1e23;\n    --text: #e6e6ea;\n    --muted: #9a9aa6;\n    --border: #2e2f36;\n    --accent: #7b9bff;\n    --accent-bg: #252b45;\n    --err-bg: #3a1f22;\n    --code-bg: #26272d;\n  }\n}\n* { box-sizing: border-box; }\nhtml, body, #root { height: 100%; margin: 0; }\nbody { background: var(--bg); }\nbutton, select, textarea { font: inherit; color: inherit; }\nbutton {\n  cursor: pointer; border: 1px solid var(--border); background: var(--panel);\n  border-radius: 6px; padding: 4px 10px;\n}\nbutton:hover:not(:disabled) { border-color: var(--accent); }\nbutton:disabled { opacity: 0.5; cursor: default; }\nbutton.small { padding: 2px 8px; font-size: 12px; }\nbutton.icon { border: none; background: none; padding: 0 4px; color: var(--muted); }\nbutton.link { border: none; background: none; padding: 0; text-align: left; color: inherit; }\nselect { border: 1px solid var(--border); border-radius: 6px; padding: 3px 6px; background: var(--panel); }\ncode, pre, .mono { font-family: var(--mono); font-size: 12px; }\npre { background: var(--code-bg); padding: 8px; border-radius: 6px; overflow: auto; margin: 4px 0; white-space: pre-wrap; word-break: break-word; }\n.muted { color: var(--muted); }\n.error { color: var(--err); }\n.banner { background: var(--err-bg); padding: 6px 10px; border-radius: 6px; margin: 6px 0; }\n.label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); }\n\n.app { display: flex; flex-direction: column; height: 100%; }\n.topbar { background: var(--panel); border-bottom: 1px solid var(--border); padding: 6px 12px 0; }\n.topbar .row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }\n.topbar label { display: flex; align-items: center; gap: 6px; color: var(--muted); font-size: 12px; }\n.brand { font-size: 15px; }\n.spacer { flex: 1; }\n.small-text { font-size: 12px; }\n.conn { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--muted); }\n.conn .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); }\n.conn.bad .dot { background: var(--err); }\n.tabs { display: flex; gap: 2px; margin-top: 6px; overflow-x: auto; }\n.tab { border: none; border-bottom: 2px solid transparent; border-radius: 0; background: none; padding: 6px 10px; white-space: nowrap; color: var(--muted); }\n.tab.active { color: var(--text); border-bottom-color: var(--accent); }\n.tools-bar { padding: 4px 12px; font-size: 12px; border-bottom: 1px solid var(--border); background: var(--panel); }\n.tools-bar code { background: var(--code-bg); padding: 1px 5px; border-radius: 4px; margin-right: 4px; }\n\n.panes { flex: 1; display: grid; grid-template-columns: 280px minmax(0, 1fr) 360px; min-height: 0; }\n.pane { min-height: 0; overflow: auto; background: var(--panel); }\n.pane-head { display: flex; justify-content: space-between; align-items: center; gap: 6px; padding: 6px 10px; border-bottom: 1px solid var(--border); font-weight: 600; position: sticky; top: 0; background: var(--panel); z-index: 1; }\n.pane-head small { font-weight: normal; color: var(--muted); }\n\n/* files */\n.files { border-right: 1px solid var(--border); display: flex; flex-direction: column; }\n.file-list { list-style: none; margin: 0; padding: 4px 0; font-size: 12px; }\n.file-list li { display: flex; align-items: center; gap: 6px; padding: 2px 6px; }\n.file-list li.active, .file-list li:hover { background: var(--accent-bg); }\n.file-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: var(--mono); }\n.size { color: var(--muted); font-size: 11px; }\n.preview { border-top: 1px solid var(--border); flex: 1; min-height: 120px; overflow: auto; }\n.preview pre { margin: 6px; max-height: 50vh; }\n.table-wrap { overflow: auto; padding: 6px; }\n.table-wrap table, .md-table { border-collapse: collapse; font-size: 11px; }\n.table-wrap th, .table-wrap td, .md-table th, .md-table td { border: 1px solid var(--border); padding: 2px 5px; white-space: nowrap; }\n\n/* chat */\n.chat { display: flex; flex-direction: column; overflow: hidden; }\n.messages { flex: 1; overflow: auto; padding: 12px 16px; }\n.intro { padding: 20px 0; }\n.msg { margin-bottom: 14px; }\n.msg.user { display: flex; justify-content: flex-end; }\n.msg.user .bubble { background: var(--accent-bg); padding: 8px 12px; border-radius: 10px; max-width: 80%; white-space: pre-wrap; }\n.md p { margin: 6px 0; }\n.md h3, .md h4, .md h5, .md h6 { margin: 10px 0 4px; }\n.md ul, .md ol { margin: 4px 0; padding-left: 22px; }\n.md code { background: var(--code-bg); padding: 0 4px; border-radius: 4px; }\n.md pre code { background: none; padding: 0; }\n.tool-card { border: 1px solid var(--border); border-radius: 8px; margin: 6px 0; overflow: hidden; }\n.tool-card.error { border-color: var(--err); }\n.tool-head { display: flex; width: 100%; gap: 8px; align-items: center; border: none; border-radius: 0; background: var(--code-bg); padding: 5px 8px; text-align: left; }\n.tool-name { font-weight: 600; font-family: var(--mono); font-size: 12px; }\n.tool-summary { flex: 1; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.tool-meta { color: var(--muted); font-size: 11px; white-space: nowrap; }\n.tool-card.error .tool-meta { color: var(--err); }\n.tool-body { padding: 6px 8px; }\n.tool-body pre { max-height: 300px; }\n.chart { border: 1px solid var(--border); border-radius: 8px; padding: 8px; margin: 8px 0; overflow: auto; background: #fff; color: #222; }\n.chart-title { font-weight: 600; margin-bottom: 4px; }\n.thinking { display: flex; align-items: center; gap: 6px; font-size: 12px; }\n.spinner { display: inline-block; width: 10px; height: 10px; border: 2px solid var(--border); border-top-color: var(--accent); border-radius: 50%; animation: spin 0.8s linear infinite; }\n@keyframes spin { to { transform: rotate(360deg); } }\n.composer { border-top: 1px solid var(--border); padding: 8px 12px; }\n.chips { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 6px; }\n.chip { font-size: 12px; border-radius: 14px; padding: 3px 10px; text-align: left; }\n.composer form { display: flex; gap: 6px; align-items: flex-end; }\n.composer textarea { flex: 1; resize: vertical; border: 1px solid var(--border); border-radius: 8px; padding: 6px 8px; background: var(--panel); }\n.composer button[type='submit'] { background: var(--accent); color: #fff; border-color: var(--accent); }\n.composer .stop { background: var(--err); color: #fff; border-color: var(--err); }\n.composer .secondary { color: var(--muted); }\n\n/* log */\n.log { border-left: 1px solid var(--border); }\n.run-meta { display: flex; justify-content: space-between; padding: 6px 10px; font-size: 12px; }\n.status { font-weight: 600; }\n.status.running { color: var(--accent); }\n.status.done { color: var(--ok); }\n.status.error, .status.aborted { color: var(--err); }\n.totals { display: grid; grid-template-columns: auto 1fr; gap: 2px 10px; margin: 0; padding: 4px 10px 8px; font-size: 12px; border-bottom: 1px solid var(--border); }\n.totals dt { color: var(--muted); }\n.totals dd { margin: 0; text-align: right; font-variant-numeric: tabular-nums; }\n.log-table { width: 100%; border-collapse: collapse; font-size: 12px; }\n.log-table th { text-align: left; color: var(--muted); font-weight: normal; padding: 3px 8px; border-bottom: 1px solid var(--border); }\n.log-table td { padding: 2px 8px; border-bottom: 1px solid var(--border); }\n.log-table .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }\n.log-table tr.step-row td { background: var(--code-bg); }\n.log-table tr.err td { color: var(--err); }\n.history { padding: 8px 0; }\n.history .label { padding: 0 10px; }\n\n@media (max-width: 900px) {\n  .panes { grid-template-columns: 1fr; grid-auto-rows: minmax(300px, auto); overflow: auto; }\n}\n"]],"\n  ",["BODY",{},"\n    ",["DIV",{"id":"root"},["DIV",{"class":"app"},["HEADER",{"class":"topbar"},["DIV",{"class":"row"},["STRONG",{"class":"brand"},"Browser Agent Eval"],["LABEL",{},"Harness",["SELECT",{"data-testid":"harness-select"},["OPTION",{"__playwright_selected_":"false","value":"aisdk"},"Vercel AI SDK v7"],["OPTION",{"__playwright_selected_":"true","value":"handrolled"},"Hand-rolled (fetch + SSE)"],["OPTION",{"__playwright_selected_":"false","value":"openai-agents"},"OpenAI Agents SDK"]]],["LABEL",{},"Model",["SELECT",{"data-testid":"model-select"}]],["SPAN",{"class":"spacer"}],["SPAN",{"class":"conn bad","data-testid":"connection","title":"undefined\nAI: (none)"},["SPAN",{"class":"dot"}],"connecting…"]],["NAV",{"class":"tabs","role":"tablist"},["BUTTON",{"role":"tab","aria-selected":"true","class":"tab active","title":"Streaming chat, tool calls, in-browser filesystem and just-bash.","data-testid":"d